{
  "name": "منصة السلامة HSE",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "منصة السلامة", "onAutoForward": "openPreview" }
  },
  "postCreateCommand": "npm install && node server/seed.js --force",
  "postAttachCommand": "node server/index.js"
}
