# منصة السلامة — متغيرات البيئة (انسخ إلى .env أو مرّرها للعملية مباشرة)
# لا تضع أي أسرار في الكود أو في هذا الملف — هذا نموذج فقط

# منفذ الخادم (الافتراضي 3000)
PORT=3000

# مسار قاعدة بيانات SQLite (الافتراضي data/hse.db داخل المشروع)
# في الإنتاج ضعها على قرص دائم مشمول بالنسخ الاحتياطي
HSE_DB=./data/hse.db
